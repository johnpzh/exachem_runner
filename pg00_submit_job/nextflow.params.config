// input and template files are relative to the repo root, which is `projectDir.parent` because the
// pipeline script being run lives in <repo>/scripts
params {
    // ExaChem input JSON for the first run
    input = "${projectDir.parent}/submodules/exachem/inputs/ozone.json"

    // The restart run needs its own input with "SCF.restart: true", and with
    // "common.file_prefix" set to the first run's prefix so it finds those output files
    restart_input = "${projectDir.parent}/pg00_submit_job/data/ozone2.json"

    // Slurm account for charging
    account = "BR26_PENG599"

    // Email address for Slurm notifications (--mail-user)
    mail_user = "zhen.peng@pnnl.gov"

    // Slurm partition (Slurm -p); "" omits the flag, for clusters that do not select by partition
    slurm_partition = "slurm"

    // Slurm QOS (--qos); "" omits the flag. E.g. on NERSC Perlmutter: "regular", "debug", or "premium"
    slurm_qos = ""

    // Slurm constraint (--constraint); "" omits the flag. E.g. on Perlmutter: "cpu" or "gpu"
    slurm_constraint = ""

    // Slurm job time limit, e.g. "1h", "2d", or "04:44:44"
    slurm_job_time_limit = "1h"

    // Number of nodes to reserve (Slurm -N)
    nodes = 1

    // Number of MPI ranks (mpirun -n)
    np = 2

    // Remote server host name or IP address
    remote_host = "deception"

    // Template pipeline run on the remote for the first run
    nextflow_slurm_template_file = "${projectDir.parent}/scripts/template00.nextflow.slurm.run_mpirun.v2.nf"

    // Template pipeline run on the remote for the restart run
    nextflow_restart_template_file = "${projectDir.parent}/scripts/template01.nextflow.slurm.run_mpirun.restart.nf"

    // true to fetch results from the remote server to local machine
    do_fetch_results = true

    // TAMM installation path on the remote server
    remote_tamm_install_path = "/qfs/people/peng599/local/install/tamm"

    // Remote workspace directory, set by the submit script in sbatch/
    remote_workspace_dir_basename = ""
}
