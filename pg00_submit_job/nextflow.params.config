// input and template files are relative to the repo root, which is `projectDir.parent` because the
// pipeline script being run lives in <repo>/scripts
params {
    input = "${projectDir.parent}/submodules/exachem/inputs/ozone.json"
    // The restart run needs its own input with "SCF.restart: true", and with
    // "common.file_prefix" set to the first run's prefix so it finds those output files
    restart_input = "${projectDir.parent}/pg00_submit_job/data/ozone2.json"
    account = "BR26_PENG599" // Slurm account for charging
    slurm_partition = "slurm" // Slurm partition to submit to (Slurm -p)
    slurm_job_time_limit = "1h" // Slurm job time limit, e.g. "1h", "2d", or "04:44:44"
    nodes = 1 // Number of nodes to reserve (Slurm -N)
    np = 2 // Number of MPI ranks (mpirun -n)
    remote_host = "deception" // Remote server host name or IP address
    nextflow_slurm_template_file = "${projectDir.parent}/scripts/template00.nextflow.slurm.run_mpirun.v2.nf"
    nextflow_restart_template_file = "${projectDir.parent}/scripts/template01.nextflow.slurm.run_mpirun.restart.nf"
    do_fetch_results = true  // true to fetch results from the remote server to local machine
    remote_tamm_install_path = "/qfs/people/peng599/local/install/tamm" // TAMM installation path on the remote server
    remote_workspace_dir_basename = "" // Remote workspace directory, set by the submit script in sbatch/
}
